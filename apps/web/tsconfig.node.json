{
  "extends": "@repo/typescript-config/base.json",
  "include": [
    "src/env.client.ts",
    "src/env.shared.ts",
    "vite.config.ts",
    "scripts/**/*.ts"
  ],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "#/*": ["./src/*"]
    }
  }
}
