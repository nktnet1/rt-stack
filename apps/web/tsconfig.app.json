{
  "extends": "@repo/typescript-config/vite.json",
  "include": [
    "env.client.ts",
    "env.shared.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/style.css"
  ],
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"]
    }
  }
}
